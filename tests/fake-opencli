      exit 0
    fi
    if [ "${SWR_FAKE_FURNITURE:-}" = "1" ]; then
      # What a readability extractor hands back when it grabs the page chrome
      # instead of the page: link labels and a cookie line, no prose. Sized
      # like the real footer that once shipped as "content" with exit 0.
      printf '%s\\n' '{"title":"Listings","content":"- [Mobile apps](/mobileapps)\n- [Help and Feedback](/help)\n- [Advertising services](/ads)\n- [Business on the marketplace](/business)\n- [Company blog](/blog)\n- [Terms of use](/terms)\n- [Privacy policy](/privacy)\n- [Banner advertising](/banners)\n- [Safety rules](/safety)\n- [Sitemap](/sitemap)\n- [Regions map](/regions)\n- [Shops map](/shops)\n- [Popular queries](/popular)\n- [Careers](/careers)\n- [Google Play](/android)\n- [App Store](/ios)\n- [Marketplace BG](/bg)\n- [Marketplace PL](/pl)\n- [Marketplace RO](/ro)\n- [Marketplace UA](/ua)\n- [Cookie settings](/cookies)\n- [Report a listing](/report)\n- [Buyer protection](/protection)\n- [Delivery](/delivery)\n- [Payments](/payments)\n- [Contact support](/contact)\nFree app for your phone. This site uses cookies. You can change cookie settings in your browser."}'
      exit 0
    fi
    if [ "${SWR_FAKE_THIN_EXTRACT:-}" = "1" ] || [ "${SWR_FAKE_L3:-}" = "1" ]; then
      printf '%s\n' '{"title":"Fake browser","content":"thin"}'
      exit 0
    fi
    printf '%s\n' '{"title":"Fake browser","content":"This response is intentionally long enough to prove that L2 returned browser content without launching Chrome. It contains a complete, deterministic fixture for the session lifecycle and argument contract test, so the test can verify background-window behavior without changing the active application window."}'
    exit 0
    ;;
  get)
    if [ "${SWR_FAKE_ERROR:-}" = "1" ]; then
      printf '%s\n' '<main><h1>Unavailable</h1><p>HTTP ERROR 418</p></main>'
      exit 0
    fi
    if [ "${SWR_FAKE_L3:-}" = "1" ]; then exit 1; fi
    printf '%s\n' '<main><h1>DOM fallback</h1><p>This deterministic landmark contains the product details that extract failed to return. It intentionally includes enough readable product information to pass the same credibility threshold as a real catalog card: plan, duration, delivery method, seller terms, and availability.</p></main>'
    exit 0
    ;;
  network)
    if [ "${SWR_FAKE_L3:-}" = "1" ]; then
      if [ "${4:-}" = "--detail" ]; then
        if [ "${5:-}" = "first-party" ]; then
          printf '%s\n' '{"plan":"SuperGrok","duration_days":7,"source":"first-party-api"}'
          exit 0
        fi
        exit 1
      fi
      printf '%s\n' '[{"key":"third-party","url":"https://cdn.example.net/consent.json"},{"key":"first-party","url":"http://127.0.0.1/api/catalog"}]'
      exit 0
    fi
    ;;
esac

exit 1
