#!/usr/bin/env bash
set -eu

: "${SWR_OPENCLI_LOG:?SWR_OPENCLI_LOG is required}"
printf '%s\n' "$*" >> "$SWR_OPENCLI_LOG"

if [ "${1:-}" = "--version" ]; then exit 0; fi

# The bridge probe. An installed opencli whose extension is unreachable (Chrome
# closed, extension disabled) is the state that used to be indistinguishable
# from an antibot wall. With SWR_FAKE_HEAL=1 a daemon restart revives it, the
# way it does on a real machine.
HEALED="${SWR_OPENCLI_LOG}.healed"
down(){ [ "${SWR_FAKE_NO_EXT:-}" = "1" ] && [ ! -f "$HEALED" ]; }

if [ "${1:-}" = "daemon" ] && [ "${2:-}" = "restart" ]; then
  [ "${SWR_FAKE_HEAL:-}" = "1" ] && : > "$HEALED"
  exit 0
fi
if [ "${1:-}" = "doctor" ]; then
  if down; then echo "Extension: not connected"; else echo "Extension: connected"; fi
  exit 0
fi
if down; then
  echo "error: Chrome extension not connected" >&2
  exit 1
fi

case "${3:-}" in
  open|close) exit 0 ;;
  extract)
    if [ "${SWR_FAKE_ERROR:-}" = "1" ]; then
      printf '%s\n' '{"title":"Unavailable","content":"HTTP ERROR 418"}'
      exit 0
    fi
    if [ "${SWR_FAKE_MENTION:-}" = "1" ]; then
